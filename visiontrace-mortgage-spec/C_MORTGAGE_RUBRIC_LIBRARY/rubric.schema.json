{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jeen.ai/schemas/visiontrace/mortgage-rubric/v1",
  "title": "Mortgage review rubric (v1)",
  "description": "A rubric is DATA: versioned, immutable once published, loaded by the rubric engine. Superset of the demo's rubric format (rubric_id, version, scope, criteria[id, method, severity, reason_code, escalation, guidance]) so the demo loader keeps working on the shared keys.",
  "type": "object",
  "additionalProperties": false,
  "required": ["rubric_id", "version", "status", "priority", "name_he", "name_en", "scope", "document_category", "applies_to", "policy_parameters", "evidence_policy", "allowed_inference_he", "prohibited_inference_he", "missing_data_treatment", "criteria", "verdict_policy", "examples", "expected_response", "source_refs", "changelog"],
  "properties": {
    "$schema": {"type": "string"},
    "rubric_id": {"type": "string", "pattern": "^mortgage\\.[a-z0-9_]+(\\.[a-z0-9_]+)*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"type": "string", "enum": ["DRAFT_FOR_IMPLEMENTATION", "PUBLISHED", "DEPRECATED"]},
    "priority": {"type": "string", "enum": ["MVP", "P1", "P2"]},
    "name_he": {"type": "string"},
    "name_en": {"type": "string"},
    "description": {"type": "string"},
    "scope": {"type": "string", "enum": ["document", "document_set", "case"]},
    "document_category": {"type": "string"},
    "applies_to": {
      "type": "object",
      "additionalProperties": false,
      "required": ["doc_types"],
      "properties": {
        "doc_types": {"type": "array", "items": {"type": "string"}},
        "requirement_codes": {"type": "array", "items": {"type": "string"}},
        "party_roles": {"type": "array", "items": {"type": "string"}},
        "employment_types": {"type": "array", "items": {"type": "string"}},
        "transaction_types": {"type": "array", "items": {"type": "string"}}
      }
    },
    "preconditions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "text_he"], "properties": {"id": {"type": "string"}, "text_he": {"type": "string"}, "on_unmet": {"type": "string"}}}},
    "required_fields": {"type": "array", "items": {"type": "string"}},
    "decisive_fields": {"type": "array", "items": {"type": "string"}},
    "field_lexicon": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}, "description": "field → printed Hebrew/English label variants the reader is told to recognise (matching vocabulary, never display text)."},
    "policy_parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status"],
        "properties": {
          "name": {"type": "string"},
          "value": {},
          "engineering_default": {},
          "unit": {"type": "string"},
          "status": {"type": "string", "enum": ["CONFIRMED_PUBLIC_SOURCE", "CONFIRMED_BANK_POLICY", "PENDING_BANK_POLICY", "ENGINEERING_DEFAULT"]},
          "source_ref": {"type": "string"},
          "note_he": {"type": "string"}
        }
      }
    },
    "evidence_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified_witnesses", "decisive_fields_must_be_verified", "citation_rule_he"],
      "properties": {
        "verified_witnesses": {"type": "array", "items": {"type": "string"}},
        "decisive_fields_must_be_verified": {"type": "boolean"},
        "citation_rule_he": {"type": "string"},
        "pages_in_scope": {"type": "string"}
      }
    },
    "allowed_inference_he": {"type": "array", "items": {"type": "string"}},
    "prohibited_inference_he": {"type": "array", "items": {"type": "string"}},
    "missing_data_treatment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["absent", "illegible", "ambiguous"],
      "properties": {"absent": {"type": "string"}, "illegible": {"type": "string"}, "ambiguous": {"type": "string"}, "unverified": {"type": "string"}}
    },
    "model_instructions": {"type": "object", "additionalProperties": false, "properties": {"reader_he": {"type": "string"}, "judge_system_en": {"type": "string"}, "judge_task_en": {"type": "string"}}},
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title_he", "dimension", "method", "severity", "pass_when", "fail_when", "needs_review_when", "insufficient_evidence_when", "reason_code", "escalation"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z]{2,6}-[A-Z0-9]{1,6}-[0-9]{2}$"},
          "title_he": {"type": "string"},
          "title_en": {"type": "string"},
          "dimension": {"type": "string", "enum": ["classification", "readability", "completeness", "internal_consistency", "identity_binding", "period_relevance", "recency", "cross_document_consistency", "evidence_sufficiency", "authenticity_signals", "security", "semantic"]},
          "method": {"type": "string", "enum": ["deterministic", "judge", "hybrid"]},
          "severity": {"type": "string", "enum": ["blocking", "major", "minor", "info"]},
          "inputs": {"type": "array", "items": {"type": "string"}},
          "required_fields": {"type": "array", "items": {"type": "string"}},
          "deterministic_logic": {"type": "string"},
          "judge_instructions": {"type": "string"},
          "guidance": {"type": "string", "description": "Demo-compatible short instruction (kept for the existing loader)."},
          "pass_when": {"type": "string"},
          "fail_when": {"type": "string"},
          "needs_review_when": {"type": "string"},
          "insufficient_evidence_when": {"type": "string"},
          "not_applicable_when": {"type": "string"},
          "citations_required": {"type": "array", "items": {"type": "string"}},
          "reason_code": {"type": ["string", "null"]},
          "on_fail": {"type": "string", "enum": ["INVALID", "NEEDS_REVIEW", "INFO_ONLY"]},
          "finding": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
              "code": {"type": "string"},
              "key_template": {"type": "string"},
              "review_state": {"type": "string", "enum": ["CUSTOMER_ACTION_REQUIRED", "BANKER_REVIEW_REQUIRED", "INFO"]},
              "customer_message_he": {"type": ["string", "null"]},
              "internal_message_he": {"type": "string"},
              "requested_item_template": {"type": ["string", "null"]}
            }
          },
          "escalation": {"type": "string", "enum": ["customer", "banker", "none"]},
          "human_review_required_when": {"type": "string"},
          "policy_parameters": {"type": "array", "items": {"type": "string"}},
          "source_refs": {"type": "array", "items": {"type": "string"}},
          "requirement_basis": {"type": "string", "enum": ["CONFIRMED_PUBLIC_BANK_REQUIREMENT", "STATUTORY", "PROPOSED_VALIDATION", "BANK_POLICY_REQUIRED"]}
        }
      }
    },
    "verdict_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules_he"],
      "properties": {
        "rules_he": {"type": "array", "items": {"type": "string"}},
        "precedence": {"type": "array", "items": {"type": "string"}},
        "set_status_rules_he": {"type": "array", "items": {"type": "string"}}
      }
    },
    "cross_document_dependencies": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["rubric_or_doc", "relation_he"], "properties": {"rubric_or_doc": {"type": "string"}, "relation_he": {"type": "string"}}}},
    "examples": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "situation_he", "expected"],
        "properties": {
          "label": {"type": "string", "enum": ["valid", "invalid", "uncertain", "not_applicable", "edge"]},
          "situation_he": {"type": "string"},
          "expected": {"type": "object"}
        }
      }
    },
    "expected_response": {"type": "object", "additionalProperties": false, "required": ["schema_ref"], "properties": {"schema_ref": {"type": "string"}, "judge_output_schema": {"type": "object"}, "example": {}}},
    "source_refs": {"type": "array", "items": {"type": "string"}},
    "changelog": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["version", "date", "change_he"], "properties": {"version": {"type": "string"}, "date": {"type": "string"}, "change_he": {"type": "string"}}}}
  }
}
