# Copied to backend/.env by ./run.sh setup (chmod 600, gitignored). Never commit real keys.
GEMINI_API_KEY=
GEMINI_MODEL_EXTRACT=gemini-3.8-flash
GEMINI_MODEL_JUDGE=gemini-3.8-flash
GEMINI_MODEL_AGENT=gemini-3.8-flash
GEMINI_MAX_CALLS_PER_HOUR=400
REVIEW_PROVIDER=gemini

# Case-bound Mortgage Case MCP keys: key 1 reads DEMO-MTZ-2026-001 only, key 2 reads DEMO-MTZ-2026-002 only.
# ./run.sh setup fills both with random values.
MCP_DEMO_KEY=
MCP_DEMO_KEY_2=

# VisionTrace stays BLOCKED until a real mortgage review has run through it and its findings were verified.
VISIONTRACE_MCP_URL=https://visiontrace.dev.jeenai.app/api/mcp
VISIONTRACE_MCP_KEY=
